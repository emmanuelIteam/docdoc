# Configuration de docdoc.
# Copiez ce fichier en `.env` et renseignez les valeurs. `.env` est ignoré par git.

# --- Stockage objet (S3 compatible) ---------------------------------
# Production : Scaleway Object Storage. Développement : MinIO local.
# Sans ces quatre variables, l'application démarre mais ne persiste rien :
# domaines, thèmes et comptes restent en mémoire.
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=docdoc-json-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Application ----------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Accès (passkeys) -----------------------------------------------
# Signature du cookie de session. Obligatoire en production.
# Générer avec : openssl rand -hex 32
SESSION_SECRET=
# Adresses autorisées à posséder un espace, séparées par des virgules.
# La première est aussi celle que `npm run bootstrap` pré-crée.
AUTHORIZED_EMAILS=emmanuel.grandiere@laposte.net
# RP ID WebAuthn : le nom d'hôte servi, SANS schéma ni port (ex. docdoc.example.org).
# Développement : localhost. Il doit correspondre exactement à l'origine réelle :
# une passkey est liée à cette valeur pour toute sa vie, et la changer invalide
# toutes les passkeys déjà enregistrées.
RP_ID=localhost
# Origine complète, schéma et port compris (ex. https://docdoc.example.org).
RP_ORIGIN=http://localhost:3000

# --- Envoi des codes par email --------------------------------------
# dev       : le code est écrit dans les journaux, aucun email n'est envoyé.
# scaleway  : Scaleway Transactional Email (même compte que le bucket).
# brevo     : Brevo (repli documenté).
EMAIL_PROVIDER=dev
# Expéditeur. Le domaine doit être authentifié (SPF/DKIM) chez le fournisseur :
# une adresse @laposte.net serait rejetée.
EMAIL_FROM=
EMAIL_FROM_NAME=docdoc
# Région Scaleway Transactional Email : fr-par, nl-ams ou pl-waw.
EMAIL_REGION=fr-par
# Identifiants Scaleway Transactional Email.
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
# Identifiant Brevo (si EMAIL_PROVIDER=brevo).
BREVO_API_KEY=

# --- Réglages des codes à usage unique ------------------------------
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
OTP_REQUEST_WINDOW_SECONDS=900
